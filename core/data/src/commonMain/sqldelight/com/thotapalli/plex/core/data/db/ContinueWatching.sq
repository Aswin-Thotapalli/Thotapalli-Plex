-- A snapshot of the server's continue-watching hub, kept only so the row still draws when the
-- server is unreachable.
--
-- This is a cache of one endpoint's answer, which is a different thing from the catalogue: the hub
-- is a short, server-computed, server-ordered list that includes items the viewer has never browsed
-- and therefore that media_item has never heard of. It gets its own table for exactly that reason —
-- writing it into the catalogue is what used to let a handful of hub entries stand in for a show's
-- whole episode list.
--
-- Display fields are copied rather than joined from media_item, because the common case is an item
-- the catalogue does not hold. Position is NOT copied: it comes from watch_state through
-- continue_watching_view, so a tile shows where playback actually got to rather than where the hub
-- last said it was.
CREATE TABLE continue_watching (
  rating_key TEXT NOT NULL PRIMARY KEY,
  -- The server's own ordering, which is the order the row is shown in. Not derivable locally.
  sort_index INTEGER NOT NULL,
  library_key TEXT NOT NULL,
  parent_key TEXT,
  kind TEXT NOT NULL,
  title TEXT NOT NULL,
  title_sort TEXT NOT NULL,
  year INTEGER,
  summary TEXT NOT NULL DEFAULT '',
  thumb_path TEXT,
  art_path TEXT,
  duration_ms INTEGER NOT NULL DEFAULT 0,
  season_index INTEGER,
  episode_index INTEGER,
  show_rating_key TEXT,
  show_title TEXT,
  child_count INTEGER NOT NULL DEFAULT 0,
  leaf_count INTEGER NOT NULL DEFAULT 0,
  viewed_leaf_count INTEGER NOT NULL DEFAULT 0,
  refreshed_at INTEGER NOT NULL
);

CREATE VIEW continue_watching_view AS
SELECT
  c.rating_key,
  c.library_key,
  c.parent_key,
  c.kind,
  c.title,
  c.title_sort,
  c.year,
  c.summary,
  c.thumb_path,
  c.art_path,
  c.duration_ms,
  COALESCE(w.view_offset_ms, 0) AS view_offset_ms,
  COALESCE(w.view_count, 0) AS view_count,
  c.season_index,
  c.episode_index,
  c.show_rating_key,
  c.show_title,
  c.child_count,
  c.leaf_count,
  c.viewed_leaf_count,
  c.refreshed_at,
  c.sort_index
FROM continue_watching c
LEFT JOIN watch_state w ON w.rating_key = c.rating_key;

upsert:
INSERT OR REPLACE INTO continue_watching(
  rating_key, sort_index, library_key, parent_key, kind, title, title_sort, year, summary,
  thumb_path, art_path, duration_ms,
  season_index, episode_index, show_rating_key, show_title,
  child_count, leaf_count, viewed_leaf_count, refreshed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- An item finished elsewhere must leave the row, so a refresh replaces the snapshot wholesale
-- rather than merging into it. Paired with the upserts inside one transaction.
deleteAll:
DELETE FROM continue_watching;

-- Offline. An item watched to the end since the snapshot was taken is dropped here rather than
-- shown at 100%, because watch_state may have moved on without the hub being reachable.
selectAll:
SELECT * FROM continue_watching_view
WHERE view_count = 0 OR (view_offset_ms > 0 AND (duration_ms = 0 OR view_offset_ms < duration_ms))
ORDER BY sort_index ASC;
