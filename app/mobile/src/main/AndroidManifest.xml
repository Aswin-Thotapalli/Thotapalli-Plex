<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- One app for every form factor (like Netflix and Plex): phone, tablet and Android TV
         from a single package and a single Play listing. Leanback is optional so the app is
         offered on televisions, and the touchscreen is declared not required so a television —
         which has none — is not filtered out. The app detects the television at runtime and
         switches to the ten-foot UI. See CLAUDE.md sections 8 and 13. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".ThotapalliApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="Thotapalli Plex"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThotapalliPlex">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Thotapalli Plex"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.ThotapalliPlex">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER for the phone/tablet drawer, LEANBACK_LAUNCHER for the Android TV
                     home row — the same activity is the entry point on every device. -->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
