<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice search on the TV (SpeechRecognizer). The microphone feature is not required, so a
         TV or remote without a mic still installs; the mic affordance simply reports unavailable. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- A backgrounded download keeps the process alive via a foreground service (CLAUDE.md
         section 11). DATA_SYNC is the type for a network transfer. POST_NOTIFICATIONS is a runtime
         permission on Android 13+; if the user denies it the service still runs, the ongoing
         notification simply does not appear. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A television has no touchscreen and no camera, and declaring leanback is what
         makes this build eligible for the Android TV launcher. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package-visibility filter (API 30+): without this, SpeechRecognizer cannot see the
         on-device recognition service and reports itself unavailable. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ThotapalliApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="Thotapalli Plex"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThotapalliPlex">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Thotapalli Plex"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.ThotapalliPlex">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER rather than LAUNCHER: a television has no app drawer. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps a download running while the app is backgrounded. Not exported: only this app
             starts it, via ContextCompat.startForegroundService. See DownloadService. -->
        <service
            android:name=".DownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Keeps audio playing with the screen off and draws the lock-screen / notification
             transport controls. Exported with the MediaSessionService action so the platform media
             framework can bind it. See PlaybackService and CLAUDE.md section 8 (request #2). -->
        <service
            android:name=".PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
